// Configuración de la conexión
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS (Tipos de datos con opciones fijas)
// -------------------------------------------------------------
enum Role {
  ADMINISTRADOR
  EMPLEADO
  CLIENTE
  INVITADO
}

enum ReservationStatus {
  PENDIENTE_DE_PAGO
  CONFIRMADA
  CANCELADA
}

enum PaymentMethod {
  TARJETA
  EFECTIVO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  RECHAZADO
}

// -------------------------------------------------------------
// MODELOS / TABLAS
// -------------------------------------------------------------

// 1. Usuarios del Sistema
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservas Reservation[]
}

// 2. Catálogo de Habitaciones
model Room {
  id           String   @id @default(uuid())
  numeroCuarto String   @unique
  tipo         String // Ej: Suite, Doble, Individual
  precioNoche  Float
  descripcion  String?
  videoUrl     String? // URL para streaming de video promocional
  imagenes     String[] // Arreglo de URLs con imágenes WebP
  disponible   Boolean  @default(true)
  createdAt    DateTime @default(now())

  reservas Reservation[]
}

// 3. Reservas
model Reservation {
  id            String   @id @default(uuid())
  nombreTitular String
  email         String // Para confirmación y factura
  documentoId   String // DPI / Pasaporte
  telefono      String
  fechaCheckIn  DateTime
  fechaCheckOut DateTime
  adultos       Int
  ninos         Int

  // Datos de Facturación
  nit             String?
  nombreFiscal    String?
  direccionFiscal String?

  estado ReservationStatus @default(PENDIENTE_DE_PAGO)
  total  Float

  // Relación opcional con Usuario (Permite reserva como Guest/Invitado)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Relación con Habitación
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  pago    Payment?
  factura Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 4. Pagos (Stripe / Efectivo)
model Payment {
  id                    String        @id @default(uuid())
  monto                 Float
  metodo                PaymentMethod
  estado                PaymentStatus @default(PENDIENTE)
  stripePaymentIntentId String? // ID de transacción retornado por Stripe

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
}

// 5. Empleados
model Employee {
  id        String   @id @default(uuid())
  nombre    String
  puesto    String
  telefono  String
  email     String   @unique
  createdAt DateTime @default(now())
}

// 6. Proveedores
model Supplier {
  id        String   @id @default(uuid())
  nombre    String
  empresa   String
  telefono  String
  email     String
  servicio  String
  createdAt DateTime @default(now())
}

// 7. Servicios Adicionales (Restaurante, Bar, Parqueo, Piscinas)
model AdditionalService {
  id        String   @id @default(uuid())
  categoria String // RESTAURANTE, BAR, PARQUEO, PISCINA
  nombre    String
  precio    Float
  createdAt DateTime @default(now())
}

// 8. Facturas
model Invoice {
  id               String @id @default(uuid())
  numeroFactura    String @unique
  nit              String
  nombreFiscal     String
  direccion        String
  montoAlojamiento Float
  montoServicios   Float  @default(0)
  montoTotal       Float

  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  createdAt DateTime @default(now())
}

// prisma/schema.prisma

enum EstadoTurno {
  ACTIVO
  FINALIZADO
}

model Workstation {
  id        String      @id @default(uuid())
  nombre    String // Ej: "Recepción PC-01", "Caja PC-02"
  codigo    String      @unique // Ej: "REC-PC1"
  ubicacion String // Ej: "Lobby Principal", "Restaurante"
  activa    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  turnos    WorkShift[]
}

model WorkShift {
  id            String      @id @default(uuid())
  userId        String // ID del Empleado
  workstationId String // ID de la Computadora asignada
  workstation   Workstation @relation(fields: [workstationId], references: [id])
  inicioTurno   DateTime    @default(now())
  finTurno      DateTime?
  estado        EstadoTurno @default(ACTIVO)
}
